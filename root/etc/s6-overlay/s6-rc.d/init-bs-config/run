#!/usr/bin/with-contenv bash
# shellcheck shell=bash

echo "**** Blessing Skin init ****"

# ---------------------------------------------------------------------------
# One-time setup (idempotent). Runs before Apache starts.
# ---------------------------------------------------------------------------
# Choose the Apache worker user:
#  - PUID/PGID provided -> use the LSIO 'abc' user (mapped to those IDs)
#  - otherwise          -> fall back to the Debian default (www-data)
if [[ -z ${LSIO_NON_ROOT_USER} ]]; then
    RUN_USER="abc"
    RUN_GROUP="abc"
else
    RUN_USER="www-data"
    RUN_GROUP="www-data"
fi

# Make Apache use the chosen user (envvars is sourced by svc-bs/run later).
sed -ri "s/^export APACHE_RUN_USER=.*/export APACHE_RUN_USER=${RUN_USER}/" /etc/apache2/envvars
sed -ri "s/^export APACHE_RUN_GROUP=.*/export APACHE_RUN_GROUP=${RUN_GROUP}/" /etc/apache2/envvars

echo "**** Migrating bundled storage into /data (first run) ****"
mkdir -p /data
if [[ -e /app/storage && ! -L /app/storage ]]; then
    if [[ -z "$(ls -A /data 2>/dev/null)" ]]; then
        echo "Seeding /data from bundled /app/storage tree"
        cp -a /app/storage/. /data/
    else
        echo "/data already contains data; leaving it untouched"
    fi
    rm -rf /app/storage
fi
ln -sfnT /data /app/storage

echo "**** Generating .env if not present ****"
if [[ ! -f /config/.env ]]; then
    if [[ -n "${BLESSING_ENV:-}" ]]; then
        echo "Writing user-provided .env from BLESSING_ENV"
        printf '%s' "${BLESSING_ENV}" > /config/.env
    else
        echo "Copying default .env.example"
        cp /app/.env.example /config/.env
        # Self-contained defaults unless the user overrides via env vars.
        if [[ -z "${DB_CONNECTION:-}" ]]; then
            sed -ri 's/^DB_CONNECTION=.*/DB_CONNECTION=sqlite/' /config/.env
            sed -ri 's|^DB_DATABASE=.*|DB_DATABASE=/data/database.db|' /config/.env
            sed -ri 's|^PLUGINS_DIR=.*|PLUGINS_DIR=/data/plugins|' /config/.env
        fi
    fi
fi

echo "**** Ensuring a working plugin market registry ****"
# The 6.0.2 release default (gplane.coding.net) now returns a "user not logged
# in" JSON without a `packages` key, which breaks the plugin market
# ("Undefined array key 'packages'"). Default to the community registry used by
# newer branches unless the user overrides PLUGINS_REGISTRY.
if ! grep -q '^PLUGINS_REGISTRY=' /config/.env; then
    if [[ -n "${PLUGINS_REGISTRY:-}" ]]; then
        printf 'PLUGINS_REGISTRY=%s\n' "${PLUGINS_REGISTRY}" >> /config/.env
    else
        printf '%s\n' 'PLUGINS_REGISTRY=https://bs-plugins.littleservice.cn/registry_{lang}.json' >> /config/.env
    fi
fi

echo "**** Linking .env to the persistent config ****"
ln -sfnT /config/.env /app/.env

echo "**** Applying user-provided environment overrides ****"
apply_env() {
    local key="$1"
    local val="${!key}"
    if [[ -n "${val}" ]]; then
        local esc
        esc=$(printf '%s' "${val}" | sed -e 's/[\\&|]/\\&/g')
        if grep -q "^${key}=" /config/.env; then
            sed -ri "s|^${key}=.*|${key}=${esc}|" /config/.env
        else
            echo "${key}=${val}" >> /config/.env
        fi
    fi
}

apply_env APP_DEBUG
apply_env APP_ENV
apply_env APP_URL
apply_env DB_CONNECTION
apply_env DB_HOST
apply_env DB_PORT
apply_env DB_DATABASE
apply_env DB_USERNAME
apply_env DB_PASSWORD
apply_env DB_PREFIX
apply_env PWD_METHOD
apply_env PLUGINS_DIR
apply_env PLUGINS_URL
apply_env PLUGINS_REGISTRY
apply_env CACHE_DRIVER
apply_env SESSION_DRIVER
apply_env QUEUE_CONNECTION
apply_env REDIS_CLIENT
apply_env REDIS_HOST
apply_env REDIS_PASSWORD
apply_env REDIS_PORT

# If SQLite, make sure the DB path points to the persistent data directory
if [[ "${DB_CONNECTION:-sqlite}" = "sqlite" ]] && [[ -n "${DB_DATABASE:-}" ]]; then
    if [[ "${DB_DATABASE}" != "/data/database.db" ]]; then
        sed -ri "s|^DB_DATABASE=.*|DB_DATABASE=${DB_DATABASE}|" /config/.env
    fi
fi

echo "**** Generating application key if missing ****"
if ! grep -q "^APP_KEY=base64" /config/.env; then
    cd /app
    php artisan key:generate
fi

# Permission
lsiown -R "${RUN_USER}:${RUN_GROUP}" \
    /config \
    /data \
    /app
